# Copy these into your host's environment variables. Never commit real values.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: require this code on the page before anyone can run an analysis
ACCESS_CODE=
# Optional: raises GitHub API limits (a token with no scopes is enough)
GITHUB_TOKEN=
# Optional tuning
PER_IP_LIMIT=3
DAILY_LIMIT=40
MAX_CONCURRENT=2
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
