# Add these in Vercel: Project Settings > Environment Variables. Never commit real values.
GEMINI_API_KEY=
GROQ_API_KEY=
# Strongly recommended: visitors must enter this code before anything runs
ACCESS_CODE=
# Strongly recommended on Vercel: shared server IPs hit GitHub's anonymous limit fast.
# A token with no scopes is enough.
GITHUB_TOKEN=
# Optional tuning
CALLS_PER_IP=90
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
