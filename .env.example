# Add these in Vercel: Project Settings > Environment Variables. Never commit real values.

# Sign-in (required for analysis)
SESSION_SECRET=              # 32+ random characters. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only set if your Vercel URL changes. Must match the callback URLs registered with GitHub and Google.
APP_URL=https://gitdigest1.vercel.app

# Models (at least one)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional
ACCESS_CODE=                 # extra code on top of sign-in
GITHUB_TOKEN=                # raises GitHub API limits; a token with no scopes is enough
CALLS_PER_IP=90              # model calls per signed-in user per hour
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
